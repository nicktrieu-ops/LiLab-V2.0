# GEMINI_API_KEY: Required for server-side Gemini API calls (natural human TTS narration via gemini-3.8-flash-lite-tts).
# AI Studio automatically injects this at runtime from Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional OpenRouter AI key for text drafting endpoints.
# Users configure this via the Secrets panel in the AI Studio UI.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional messaging webhooks / Zalo Official Account credentials for automated billing reminders:
# SMTP_WEBHOOK_URL="https://your-email-webhook.example.com/send"
# ZALO_WEBHOOK_URL="https://your-zalo-gateway.example.com/send"
# ZALO_OA_ACCESS_TOKEN="YOUR_ZALO_OA_ACCESS_TOKEN"


# --- LiLab V2.0 cost controls (all optional) ---
# Cloud Storage bucket for curriculum PDFs, media and recorded narration (defaults to the Firebase bucket).
# LILAB_STORAGE_BUCKET="gen-lang-client-0900806695.firebasestorage.app"
# Per-feature Gemini models. Point the story model at the cheapest Flash-Lite model your key can use.
# LILAB_STORY_MODEL="gemini-4-hydrogen"
# LILAB_SPEAKING_MODEL="gemini-4-hydrogen"
# LILAB_TTS_MODEL="gemini-3.8-flash-lite-tts"
# Daily guest (signed-out) AI requests per server instance.
# LILAB_GUEST_DAILY_AI_CAP="300"
# Firebase App Check: set both once a reCAPTCHA Enterprise key is registered.
# VITE_RECAPTCHA_SITE_KEY=""
# LILAB_REQUIRE_APP_CHECK="true"
