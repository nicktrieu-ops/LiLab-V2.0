        && data.issuedByName is string && data.issuedByName.size() >= 1 && data.issuedByName.size() <= 120
        && (!('adminUids' in data) || isValidAdminUids(data.adminUids));
    }

    function isValidStudentMindMap(data) {
      return data.keys().hasAll(['studentId', 'studentName', 'ownerUid', 'title', 'topicTag', 'cefrLevel', 'nodesJson', 'nodeCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['studentId', 'studentName', 'ownerUid', 'studentEmail', 'parentEmail', 'title', 'topicTag', 'cefrLevel', 'nodesJson', 'nodeCount', 'createdAt', 'updatedAt'])
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && isValidId(data.ownerUid)
        && (!('studentEmail' in data) || (data.studentEmail is string && data.studentEmail.size() <= 160))
        && (!('parentEmail' in data) || (data.parentEmail is string && data.parentEmail.size() <= 160))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.topicTag is string && data.topicTag.size() <= 80
        && data.cefrLevel is string && data.cefrLevel.size() <= 60
