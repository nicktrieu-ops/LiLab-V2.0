    function isValidAcademyEvent(data) {
      return data.keys().hasAll(['titleEn', 'titleVi', 'eventDate', 'startTime', 'endTime', 'eventType', 'status', 'location', 'descriptionEn', 'descriptionVi', 'createdByUid', 'createdByEmail', 'createdByName', 'createdAt', 'updatedAt'])
