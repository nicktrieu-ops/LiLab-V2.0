          && incoming().paymentMethod in ['direct_debit', 'credit_card', 'qr_transfer']
          && ('paymentReference' in incoming()) && incoming().paymentReference is string && incoming().paymentReference.size() >= 4
          && incoming().diff(existing()).affectedKeys().hasOnly(['paymentMethod', 'paymentReference', 'payerBankName', 'payerAccountHolder', 'parentPhone', 'paidAt', 'status', 'parentUid', 'updatedAt'])
