rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSuperAdmin() {
      return isVerified() && request.auth.token.email in [
        'nickmyriam@gmail.com',
        'nicktrieu@gmail.com',
        'lilabvietnam@gmail.com'
      ];
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.level == 'admin'
      ) || (
        isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'admin']
      );
    }

    function isListedAdmin() {
      return isAdmin() || (
        isVerified() &&
        ('adminUids' in existing()) &&
        existing().adminUids is list &&
        request.auth.uid in existing().adminUids
      );
    }

    function isAdminOrTeacher() {
      return isAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'admin', 'teacher']
      );
    }

    // V2: an approved account. People who register themselves start as 'pending'
    // and cannot read academy data until an admin approves them.
    function isMember() {
      return isVerified() && (
        isSuperAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        )
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasValidTimestampsOnCreate(data) {
      return data.createdAt == request.time && data.updatedAt == request.time;
    }

    function hasValidTimestampsOnUpdate(data) {
      return (!('createdAt' in existing()) || data.createdAt == existing().createdAt || data.createdAt == request.time)
        && data.updatedAt == request.time;
    }

    function isValidAdminUids(listVal) {
      return listVal is list && listVal.size() <= 20 && (listVal.size() == 0 || listVal[0] is string);
    }

    function isValidCefrLevel(lvl) {
      return lvl in ['Pre-A1 Starters', 'A1 Movers', 'A2 Flyers', 'A2 Key', 'B1 Preliminary', 'B2 First', 'C1 Advanced', 'C2 Proficiency'];
    }

    function isValidCefrModifier(mod) {
      return mod in ['-', 'standard', '+'];
    }

    function isValidScore(val) {
      return (val is int || val is float) && val >= 0 && val <= 100;
    }

    function hasValidPendingInvite(inviteId, expectedRole) {
      return isValidId(inviteId)
        && exists(/databases/$(database)/documents/user_invites/$(inviteId))
        && get(/databases/$(database)/documents/user_invites/$(inviteId)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/user_invites/$(inviteId)).data.status == 'pending'
        && get(/databases/$(database)/documents/user_invites/$(inviteId)).data.role == expectedRole;
    }

    // 3. Entity Validation Blueprints
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'level', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'level', 'claimedInviteId', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.level in ['super_admin', 'admin']
        && (!('claimedInviteId' in data) || isValidId(data.claimedInviteId));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'preferredLang', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'phone', 'photoUrl', 'preferredLang', 'claimedInviteId', 'status', 'reviewedByEmail', 'reviewedAt', 'reviewNote', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['super_admin', 'admin', 'teacher', 'parent', 'student']
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 250000))
        && data.preferredLang in ['en', 'vi', 'bi']
        && (!('claimedInviteId' in data) || isValidId(data.claimedInviteId))
        && data.status in ['active', 'inactive', 'pending', 'declined']
        && (!('reviewedByEmail' in data) || (data.reviewedByEmail is string && data.reviewedByEmail.size() <= 160))
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 40))
        && (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 300));
    }

    function isValidUserInvite(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'status', 'createdByUid', 'adminUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['email', 'displayName', 'role', 'phone', 'status', 'createdByUid', 'adminUids', 'createdAt', 'updatedAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['admin', 'teacher', 'parent', 'student']
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && data.status in ['pending', 'claimed']
        && isValidId(data.createdByUid)
        && isValidAdminUids(data.adminUids);
    }

    function isValidTeacherProfile(data) {
      return data.keys().hasAll(['teacherEmail', 'fullName', 'specialty', 'cefrCertification', 'hourlyRateVnd', 'monthlyBaseVnd', 'payStatus', 'status', 'adminUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['teacherUid', 'teacherEmail', 'fullName', 'phone', 'photoUrl', 'specialty', 'cefrCertification', 'bioEn', 'bioVi', 'hourlyRateVnd', 'monthlyBaseVnd', 'bankName', 'bankAccountNumber', 'bankAccountHolder', 'payStatus', 'payNotes', 'status', 'adminUids', 'createdAt', 'updatedAt'])
        && (!('teacherUid' in data) || (data.teacherUid is string && data.teacherUid.size() <= 128))
        && data.teacherEmail is string && data.teacherEmail.size() >= 3 && data.teacherEmail.size() <= 160
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 250000))
        && data.specialty is string && data.specialty.size() <= 160
        && data.cefrCertification is string && data.cefrCertification.size() <= 80
        && (!('bioEn' in data) || (data.bioEn is string && data.bioEn.size() <= 1000))
        && (!('bioVi' in data) || (data.bioVi is string && data.bioVi.size() <= 1000))
        && (data.hourlyRateVnd is int || data.hourlyRateVnd is float) && data.hourlyRateVnd >= 0 && data.hourlyRateVnd <= 100000000
        && (data.monthlyBaseVnd is int || data.monthlyBaseVnd is float) && data.monthlyBaseVnd >= 0 && data.monthlyBaseVnd <= 500000000
        && (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 120))
        && (!('bankAccountNumber' in data) || (data.bankAccountNumber is string && data.bankAccountNumber.size() <= 60))
        && (!('bankAccountHolder' in data) || (data.bankAccountHolder is string && data.bankAccountHolder.size() <= 120))
        && data.payStatus in ['active', 'pending_payout', 'paid']
        && (!('payNotes' in data) || (data.payNotes is string && data.payNotes.size() <= 500))
        && data.status in ['active', 'inactive']
        && isValidAdminUids(data.adminUids);
    }

    function isValidStudentProfile(data) {
      return data.keys().hasAll(['fullName', 'parentName', 'parentEmail', 'age', 'gender', 'cefrLevel', 'cefrModifier', 'enrolledClassIds', 'assignedTeacherEmails', 'status', 'adminUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fullName', 'studentEmail', 'parentName', 'parentEmail', 'parentPhone', 'photoUrl', 'parentUid', 'studentUid', 'age', 'gender', 'cefrLevel', 'cefrModifier', 'enrolledClassIds', 'assignedTeacherEmails', 'activitiesNote', 'status', 'adminUids', 'createdAt', 'updatedAt'])
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && (!('studentEmail' in data) || (data.studentEmail is string && data.studentEmail.size() <= 160))
        && data.parentName is string && data.parentName.size() >= 1 && data.parentName.size() <= 120
        && data.parentEmail is string && data.parentEmail.size() >= 3 && data.parentEmail.size() <= 160
        && (!('parentPhone' in data) || (data.parentPhone is string && data.parentPhone.size() <= 40))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 250000))
        && (!('parentUid' in data) || (data.parentUid is string && data.parentUid.size() <= 128))
        && (!('studentUid' in data) || (data.studentUid is string && data.studentUid.size() <= 128))
        && (data.age is int || data.age is float) && data.age >= 2 && data.age <= 99
        && data.gender in ['girl', 'boy']
        && isValidCefrLevel(data.cefrLevel)
        && isValidCefrModifier(data.cefrModifier)
        && data.enrolledClassIds is list && data.enrolledClassIds.size() <= 12
        && data.assignedTeacherEmails is list && data.assignedTeacherEmails.size() <= 12
        && (!('activitiesNote' in data) || (data.activitiesNote is string && data.activitiesNote.size() <= 800))
        && data.status in ['active', 'paused', 'graduated']
        && isValidAdminUids(data.adminUids);
    }

    function isValidProgramCourse(data) {
      return data.keys().hasAll(['code', 'titleEn', 'titleVi', 'descriptionEn', 'descriptionVi', 'cefrTarget', 'ageRange', 'weeksCount', 'tuitionVnd', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['code', 'titleEn', 'titleVi', 'descriptionEn', 'descriptionVi', 'cefrTarget', 'ageRange', 'weeksCount', 'tuitionVnd', 'scheduleSummary', 'teacherName', 'teacherId', 'enrollmentDate', 'startDate', 'maxClassSize', 'location', 'showInPromoPopup', 'promoBadgeEn', 'promoBadgeVi', 'isActive', 'createdAt', 'updatedAt'])
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 40
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 160
        && data.titleVi is string && data.titleVi.size() >= 1 && data.titleVi.size() <= 160
        && data.descriptionEn is string && data.descriptionEn.size() <= 1200
        && data.descriptionVi is string && data.descriptionVi.size() <= 1200
        && data.cefrTarget is string && data.cefrTarget.size() <= 60
        && data.ageRange is string && data.ageRange.size() <= 40
        && (data.weeksCount is int || data.weeksCount is float) && data.weeksCount >= 1 && data.weeksCount <= 104
        && (data.tuitionVnd is int || data.tuitionVnd is float) && data.tuitionVnd >= 0 && data.tuitionVnd <= 500000000
        && (!('scheduleSummary' in data) || (data.scheduleSummary is string && data.scheduleSummary.size() <= 160))
        && (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 120))
        && (!('teacherId' in data) || (data.teacherId is string && data.teacherId.size() <= 128))
        && (!('enrollmentDate' in data) || (data.enrollmentDate is string && data.enrollmentDate.size() <= 30))
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 30))
        && (!('maxClassSize' in data) || ((data.maxClassSize is int || data.maxClassSize is float) && data.maxClassSize >= 1 && data.maxClassSize <= 100))
        && (!('location' in data) || (data.location is string && data.location.size() <= 160))
        && (!('showInPromoPopup' in data) || data.showInPromoPopup is bool)
        && (!('promoBadgeEn' in data) || (data.promoBadgeEn is string && data.promoBadgeEn.size() <= 80))
        && (!('promoBadgeVi' in data) || (data.promoBadgeVi is string && data.promoBadgeVi.size() <= 80))
        && data.isActive is bool;
    }

    function isValidAcademyClass(data) {
      return data.keys().hasAll(['name', 'programId', 'programTitle', 'teacherEmail', 'teacherName', 'cefrLevel', 'cefrModifier', 'room', 'scheduleText', 'maxStudents', 'studentIds', 'status', 'adminUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'programId', 'programTitle', 'teacherUid', 'teacherEmail', 'teacherName', 'cefrLevel', 'cefrModifier', 'room', 'scheduleText', 'maxStudents', 'studentIds', 'status', 'adminUids', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && isValidId(data.programId)
        && data.programTitle is string && data.programTitle.size() <= 160
        && (!('teacherUid' in data) || (data.teacherUid is string && data.teacherUid.size() <= 128))
        && data.teacherEmail is string && data.teacherEmail.size() >= 3 && data.teacherEmail.size() <= 160
        && data.teacherName is string && data.teacherName.size() <= 120
        && data.cefrLevel is string && data.cefrLevel.size() <= 60
        && isValidCefrModifier(data.cefrModifier)
        && data.room is string && data.room.size() <= 60
        && data.scheduleText is string && data.scheduleText.size() <= 160
        && (data.maxStudents is int || data.maxStudents is float) && data.maxStudents >= 1 && data.maxStudents <= 100
        && data.studentIds is list && data.studentIds.size() <= 30
        && data.status in ['active', 'upcoming', 'completed']
        && isValidAdminUids(data.adminUids);
    }

    function isValidClassSchedule(data) {
      return data.keys().hasAll(['classId', 'className', 'teacherEmail', 'teacherName', 'dayOfWeek', 'startTime', 'endTime', 'room', 'weekNumber', 'topicEn', 'topicVi', 'status', 'adminUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['classId', 'className', 'teacherUid', 'teacherEmail', 'teacherName', 'dayOfWeek', 'startTime', 'endTime', 'room', 'weekNumber', 'topicEn', 'topicVi', 'status', 'adminUids', 'createdAt', 'updatedAt'])
        && isValidId(data.classId)
        && data.className is string && data.className.size() <= 120
        && (!('teacherUid' in data) || (data.teacherUid is string && data.teacherUid.size() <= 128))
        && data.teacherEmail is string && data.teacherEmail.size() >= 3 && data.teacherEmail.size() <= 160
        && data.teacherName is string && data.teacherName.size() <= 120
        && data.dayOfWeek in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
        && data.startTime is string && data.startTime.size() <= 20
        && data.endTime is string && data.endTime.size() <= 20
        && data.room is string && data.room.size() <= 60
        && (data.weekNumber is int || data.weekNumber is float) && data.weekNumber >= 1 && data.weekNumber <= 52
        && data.topicEn is string && data.topicEn.size() <= 200
        && data.topicVi is string && data.topicVi.size() <= 200
        && data.status in ['scheduled', 'completed', 'cancelled']
        && isValidAdminUids(data.adminUids);
    }

    function isValidStudentAssessment(data) {
      return data.keys().hasAll(['studentId', 'studentName', 'classId', 'className', 'teacherEmail', 'teacherName', 'parentEmail', 'termLabel', 'cefrLevel', 'cefrModifier', 'speakingScore', 'readingScore', 'writingScore', 'socialScore', 'emotionalScore', 'mentalScore', 'teacherCommentEn', 'teacherCommentVi', 'activitiesCompleted', 'adminUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['studentId', 'studentName', 'classId', 'className', 'teacherUid', 'teacherEmail', 'teacherName', 'parentEmail', 'studentEmail', 'termLabel', 'cefrLevel', 'cefrModifier', 'speakingScore', 'readingScore', 'writingScore', 'vocabularyScore', 'comprehensionScore', 'socialScore', 'emotionalScore', 'mentalScore', 'teacherCommentEn', 'teacherCommentVi', 'aiInsightEn', 'aiInsightVi', 'activitiesCompleted', 'adminUids', 'createdAt', 'updatedAt'])
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() <= 120
        && isValidId(data.classId)
        && data.className is string && data.className.size() <= 120
        && (!('teacherUid' in data) || (data.teacherUid is string && data.teacherUid.size() <= 128))
        && data.teacherEmail is string && data.teacherEmail.size() >= 3 && data.teacherEmail.size() <= 160
        && data.teacherName is string && data.teacherName.size() <= 120
        && data.parentEmail is string && data.parentEmail.size() >= 3 && data.parentEmail.size() >= 0 && data.parentEmail.size() <= 160
        && (!('studentEmail' in data) || (data.studentEmail is string && data.studentEmail.size() <= 160))
        && data.termLabel is string && data.termLabel.size() <= 80
        && isValidCefrLevel(data.cefrLevel)
        && isValidCefrModifier(data.cefrModifier)
        && isValidScore(data.speakingScore)
        && isValidScore(data.readingScore)
        && isValidScore(data.writingScore)
        && (!('vocabularyScore' in data) || isValidScore(data.vocabularyScore))
        && (!('comprehensionScore' in data) || isValidScore(data.comprehensionScore))
        && isValidScore(data.socialScore)
        && isValidScore(data.emotionalScore)
        && isValidScore(data.mentalScore)
        && data.teacherCommentEn is string && data.teacherCommentEn.size() <= 1500
        && data.teacherCommentVi is string && data.teacherCommentVi.size() <= 1500
        && (!('aiInsightEn' in data) || (data.aiInsightEn is string && data.aiInsightEn.size() <= 2000))
        && (!('aiInsightVi' in data) || (data.aiInsightVi is string && data.aiInsightVi.size() <= 2000))
        && data.activitiesCompleted is list && data.activitiesCompleted.size() <= 20
        && isValidAdminUids(data.adminUids);
    }

    function isValidGeminiNote(data) {
      return data.keys().hasAll(['title', 'weekNumber', 'programTitle', 'summaryEn', 'summaryVi', 'keyVocabulary', 'uploadedByUid', 'uploadedByEmail', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'weekNumber', 'programTitle', 'sourceFileName', 'summaryEn', 'summaryVi', 'keyVocabulary', 'phonicsFocus', 'grammarFocus', 'activitiesEn', 'activitiesVi', 'uploadedByUid', 'uploadedByEmail', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && (data.weekNumber is int || data.weekNumber is float) && data.weekNumber >= 1 && data.weekNumber <= 52
        && data.programTitle is string && data.programTitle.size() <= 120
        && (!('sourceFileName' in data) || (data.sourceFileName is string && data.sourceFileName.size() <= 200))
        && data.summaryEn is string && data.summaryEn.size() <= 2500
        && data.summaryVi is string && data.summaryVi.size() <= 2500
        && data.keyVocabulary is list && data.keyVocabulary.size() <= 40
        && (!('phonicsFocus' in data) || (data.phonicsFocus is string && data.phonicsFocus.size() <= 500))
        && (!('grammarFocus' in data) || (data.grammarFocus is string && data.grammarFocus.size() <= 500))
        && (!('activitiesEn' in data) || (data.activitiesEn is string && data.activitiesEn.size() <= 1500))
        && (!('activitiesVi' in data) || (data.activitiesVi is string && data.activitiesVi.size() <= 1500))
        && isValidId(data.uploadedByUid)
        && data.uploadedByEmail is string && data.uploadedByEmail.size() >= 3 && data.uploadedByEmail.size() <= 160;
    }

    function isValidTuitionInvoice(data) {
      return data.keys().hasAll(['invoiceNumber', 'studentId', 'studentName', 'parentEmail', 'programTitle', 'amountVnd', 'dueDate', 'status', 'paymentMethod', 'adminUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['invoiceNumber', 'studentId', 'studentName', 'parentEmail', 'parentUid', 'parentPhone', 'programId', 'programTitle', 'amountVnd', 'dueDate', 'status', 'paymentMethod', 'paymentReference', 'payerBankName', 'payerAccountHolder', 'paidAt', 'reminderNote', 'reminderChannel', 'lastReminderAt', 'adminUids', 'createdAt', 'updatedAt'])
        && data.invoiceNumber is string && data.invoiceNumber.size() >= 1 && data.invoiceNumber.size() <= 40
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() <= 120
        && data.parentEmail is string && data.parentEmail.size() >= 3 && data.parentEmail.size() <= 160
        && (!('parentUid' in data) || (data.parentUid is string && data.parentUid.size() <= 128))
        && (!('parentPhone' in data) || (data.parentPhone is string && data.parentPhone.size() <= 40))
        && (!('programId' in data) || (data.programId is string && data.programId.size() <= 128))
        && data.programTitle is string && data.programTitle.size() <= 160
        && (data.amountVnd is int || data.amountVnd is float) && data.amountVnd >= 0 && data.amountVnd <= 500000000
        && data.dueDate is string && data.dueDate.size() <= 30
        && data.status in ['pending', 'paid', 'overdue', 'reminder_sent']
        && data.paymentMethod in ['unselected', 'direct_debit', 'credit_card', 'qr_transfer']
        && (!('paymentReference' in data) || (data.paymentReference is string && data.paymentReference.size() <= 120))
        && (!('payerBankName' in data) || (data.payerBankName is string && data.payerBankName.size() <= 120))
        && (!('payerAccountHolder' in data) || (data.payerAccountHolder is string && data.payerAccountHolder.size() <= 120))
        && (!('paidAt' in data) || (data.paidAt is string && data.paidAt.size() <= 40))
        && (!('reminderNote' in data) || (data.reminderNote is string && data.reminderNote.size() <= 500))
        && (!('reminderChannel' in data) || data.reminderChannel in ['email', 'zalo', 'both'])
        && (!('lastReminderAt' in data) || (data.lastReminderAt is string && data.lastReminderAt.size() <= 40))
        && isValidAdminUids(data.adminUids);
    }

    function isValidPayableRecord(data) {
      return data.keys().hasAll(['recordType', 'recipientName', 'bankName', 'bankAccountNumber', 'bankAccountHolder', 'amountVnd', 'dueDate', 'status', 'adminUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['recordType', 'recipientName', 'recipientEmail', 'bankName', 'bankAccountNumber', 'bankAccountHolder', 'amountVnd', 'dueDate', 'status', 'notes', 'adminUids', 'createdAt', 'updatedAt'])
        && data.recordType in ['teacher_payroll', 'vendor_expense', 'academy_bank_config']
        && data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 120
        && (!('recipientEmail' in data) || (data.recipientEmail is string && data.recipientEmail.size() <= 160))
        && data.bankName is string && data.bankName.size() <= 120
        && data.bankAccountNumber is string && data.bankAccountNumber.size() <= 60
        && data.bankAccountHolder is string && data.bankAccountHolder.size() <= 120
        && (data.amountVnd is int || data.amountVnd is float) && data.amountVnd >= 0 && data.amountVnd <= 2000000000
        && data.dueDate is string && data.dueDate.size() <= 30
        && data.status in ['scheduled', 'paid', 'pending', 'active']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 600))
        && isValidAdminUids(data.adminUids);
    }

    function isValidEnrollmentRequest(data) {
      return data.keys().hasAll(['studentId', 'studentName', 'parentUid', 'parentEmail', 'programId', 'programTitle', 'status', 'adminUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['studentId', 'studentName', 'parentUid', 'parentEmail', 'programId', 'programTitle', 'preferredSchedule', 'notes', 'status', 'adminUids', 'createdAt', 'updatedAt'])
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() <= 120
        && isValidId(data.parentUid)
        && data.parentEmail is string && data.parentEmail.size() >= 3 && data.parentEmail.size() <= 160
        && isValidId(data.programId)
        && data.programTitle is string && data.programTitle.size() <= 160
        && (!('preferredSchedule' in data) || (data.preferredSchedule is string && data.preferredSchedule.size() <= 160))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.status in ['pending', 'approved', 'enrolled']
        && isValidAdminUids(data.adminUids);
    }

    function isValidParentPaymentMethod(data) {
