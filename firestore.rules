    function isValidStudentStudyNote(data) {
      return data.keys().hasAll(['studentId', 'studentName', 'ownerUid', 'title', 'subjectTag', 'cefrLevel', 'blocksJson', 'vocabJson', 'excerpt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['studentId', 'studentName', 'ownerUid', 'studentEmail', 'parentEmail', 'title', 'subjectTag', 'cefrLevel', 'blocksJson', 'vocabJson', 'excerpt', 'createdAt', 'updatedAt'])
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && isValidId(data.ownerUid)
        && (!('studentEmail' in data) || (data.studentEmail is string && data.studentEmail.size() <= 160))
        && (!('parentEmail' in data) || (data.parentEmail is string && data.parentEmail.size() <= 160))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.subjectTag is string && data.subjectTag.size() <= 80
        && data.cefrLevel is string && data.cefrLevel.size() <= 60
        && data.blocksJson is string && data.blocksJson.size() >= 2 && data.blocksJson.size() <= 50000
        && data.vocabJson is string && data.vocabJson.size() >= 2 && data.vocabJson.size() <= 15000
        && data.excerpt is string && data.excerpt.size() <= 300;
