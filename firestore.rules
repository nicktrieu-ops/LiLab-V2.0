        (isAdmin() && existing().role != 'super_admin' && incoming().role != 'super_admin') ||
        (isOwner(uid) && isVerified() && incoming().role == existing().role && incoming().email == existing().email && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'photoUrl', 'preferredLang', 'updatedAt']))
      );
