          'className', 'termLabel', 'teacherName', 'directorName', 'directorTitleEn',
          'directorTitleVi', 'awardTitleEn', 'awardTitleVi', 'citationEn', 'citationVi',
          'issueDate', 'certLang', 'theme', 'showScores', 'showStudentPhoto', 'hasScores',
