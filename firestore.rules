    function isValidStudentCodeProgress(data) {
      return data.keys().hasAll(['studentId', 'studentName', 'ownerUid', 'xpPoints', 'completedChallengeIds', 'earnedBadgeIds', 'currentStreak', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['studentId', 'studentName', 'ownerUid', 'studentEmail', 'parentEmail', 'xpPoints', 'completedChallengeIds', 'earnedBadgeIds', 'currentStreak', 'lastCompletedAt', 'createdAt', 'updatedAt'])
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && isValidId(data.ownerUid)
        && (!('studentEmail' in data) || (data.studentEmail is string && data.studentEmail.size() <= 160))
        && (!('parentEmail' in data) || (data.parentEmail is string && data.parentEmail.size() <= 160))
        && (data.xpPoints is int || data.xpPoints is float) && data.xpPoints >= 0 && data.xpPoints <= 100000
        && data.completedChallengeIds is list && data.completedChallengeIds.size() <= 50 && (data.completedChallengeIds.size() == 0 || data.completedChallengeIds[0] is string)
        && data.earnedBadgeIds is list && data.earnedBadgeIds.size() <= 30 && (data.earnedBadgeIds.size() == 0 || data.earnedBadgeIds[0] is string)
        && (data.currentStreak is int || data.currentStreak is float) && data.currentStreak >= 0 && data.currentStreak <= 365
        && (!('lastCompletedAt' in data) || (data.lastCompletedAt is string && data.lastCompletedAt.size() <= 40));
    }

    // 4. Collection Rules

    // /admins/{uid}
    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(uid) && isValidAdminRecord(incoming()) && hasValidTimestampsOnCreate(incoming()) && (
        (isSuperAdmin() && incoming().uid == uid) ||
        (isVerified() && request.auth.uid == uid && incoming().uid == uid && incoming().email == request.auth.token.email && incoming().level == 'super_admin' && isSuperAdmin()) ||
        (isVerified() && request.auth.uid == uid && incoming().uid == uid && incoming().email == request.auth.token.email && incoming().level == 'admin' && ('claimedInviteId' in incoming()) && hasValidPendingInvite(incoming().claimedInviteId, 'admin'))
      );
      allow update: if isValidId(uid) && isAdmin() && isValidAdminRecord(incoming()) && hasValidTimestampsOnUpdate(incoming()) && incoming().uid == existing().uid;
      allow delete: if isValidId(uid) && isSuperAdmin() && !(existing().email in ['nickmyriam@gmail.com', 'nicktrieu@gmail.com', 'lilabvietnam@gmail.com']);
    }

    // /users/{uid} — Strict PII Isolation
    match /users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(uid) && isValidUserProfile(incoming()) && hasValidTimestampsOnCreate(incoming()) && (
        (isAdmin() && incoming().uid == uid) ||
        (
          isVerified() && request.auth.uid == uid && incoming().uid == uid && incoming().email == request.auth.token.email && (
            (isSuperAdmin() && incoming().role == 'super_admin') ||
