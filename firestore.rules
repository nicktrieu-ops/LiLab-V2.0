        && (data.studentAge is int || data.studentAge is float) && data.studentAge >= 2 && data.studentAge <= 25
        && data.studentGender in ['girl', 'boy']
        && (!('studentPhotoUrl' in data) || (data.studentPhotoUrl is string && data.studentPhotoUrl.size() <= 250000))
