          )
        );
      allow delete: if isValidId(progressId) && (isAdmin() || (isMember() && existing().ownerUid == request.auth.uid));
    }
    // V2 CRM: admins only
    function isValidCrmDoc(data) {
      return data.size() <= 40
        && (!('fullName' in data) || (data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 160))
        && (!('title' in data) || (data.title is string && data.title.size() >= 1 && data.title.size() <= 200))
        && (!('body' in data) || (data.body is string && data.body.size() <= 4000))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20))
        && (!('amountVnd' in data) || (data.amountVnd is number && data.amountVnd >= 0));
    }

    match /crm_contacts/{id} {
      allow read: if isValidId(id) && isAdmin();
      allow create, update: if isValidId(id) && isAdmin() && isValidCrmDoc(incoming());
      allow delete: if isValidId(id) && isAdmin();
    }
    match /crm_deals/{id} {
      allow read: if isValidId(id) && isAdmin();
      allow create, update: if isValidId(id) && isAdmin() && isValidCrmDoc(incoming());
      allow delete: if isValidId(id) && isAdmin();
    }
    match /crm_activities/{id} {
      allow read: if isValidId(id) && isAdmin();
      allow create: if isValidId(id) && isAdmin() && isValidCrmDoc(incoming()) && incoming().authorEmail == request.auth.token.email;
      allow update, delete: if isValidId(id) && isAdmin();
    }
    match /crm_tasks/{id} {
      allow read: if isValidId(id) && isAdmin();
      allow create, update: if isValidId(id) && isAdmin() && isValidCrmDoc(incoming());
      allow delete: if isValidId(id) && isAdmin();
    }
  }
}
