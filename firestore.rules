        && (!('parentUid' in data) || (data.parentUid is string && data.parentUid.size() <= 128))
        && (!('studentEmail' in data) || (data.studentEmail is string && data.studentEmail.size() <= 160))
        && (!('assessmentId' in data) || (data.assessmentId is string && data.assessmentId.size() <= 128))
        && data.serialId is string && data.serialId.size() >= 4 && data.serialId.size() <= 60
        && isValidCefrLevel(data.cefrLevel)
        && isValidCefrModifier(data.cefrModifier)
        && data.cefrDisplay is string && data.cefrDisplay.size() >= 1 && data.cefrDisplay.size() <= 80
        && (data.pceLevelNumber is int || data.pceLevelNumber is float) && data.pceLevelNumber >= 1 && data.pceLevelNumber <= 13
        && data.className is string && data.className.size() >= 1 && data.className.size() <= 120
        && data.termLabel is string && data.termLabel.size() >= 1 && data.termLabel.size() <= 120
        && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 120
        && data.directorName is string && data.directorName.size() >= 1 && data.directorName.size() <= 120
        && data.directorTitleEn is string && data.directorTitleEn.size() >= 1 && data.directorTitleEn.size() <= 120
        && data.directorTitleVi is string && data.directorTitleVi.size() >= 1 && data.directorTitleVi.size() <= 120
        && data.awardTitleEn is string && data.awardTitleEn.size() >= 1 && data.awardTitleEn.size() <= 160
        && data.awardTitleVi is string && data.awardTitleVi.size() >= 1 && data.awardTitleVi.size() <= 160
